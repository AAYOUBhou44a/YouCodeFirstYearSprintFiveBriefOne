{% extends "layout/base.html.twig" %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block content %}
    <h2>Liste des Utilisateurs</h2>
    <a href="/debriefing/users/create" class="button">Créer un utilisateur</a>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Nom</th>
                <th>Email</th>
                <th>Rôle</th>
                <th>Classe (ID)</th>
            </tr>
        </thead>
        <tbody>
            {% for u in users %}
                <tr>
                    <td>{{ u.id }}</td>
                    <td>{{ u.firstName }} {{ u.lastName }}</td>
                    <td>{{ u.email }}</td>
                    <td>{{ u.role }}</td>
                    {% if u.role == 'student' %}
                        <td>{{ u.classId }}</td>
                    {% else %}
                        <td>-</td>
                    {% endif %}
                </tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}

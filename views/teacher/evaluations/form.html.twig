{% extends "layout/base.html.twig" %}

{% block title %}Évaluation: {{ student.firstName }} {{ student.lastName }}{% endblock %}

{% block content %}
    <h2>Évaluation pour {{ student.firstName }} {{ student.lastName }}</h2>
    <h3>Brief: {{ brief.title }}</h3>

    <form action="/debriefing/evaluations/store" method="POST">
        <input type="hidden" name="brief_id" value="{{ brief.id }}">
        <input type="hidden" name="student_id" value="{{ student.id }}">

        <table>
            <thead>
                <tr>
                    <th>Compétence</th>
                    <th>Niveau</th>
                    <th>Commentaire</th>
                </tr>
            </thead>
            <tbody>
                {% for skill in skills %}
                    {% set savedEval = evalMap[skill.id] ?? null %}
                    <tr>
                        <td>{{ skill.code }} - {{ skill.title }}</td>
                        <td>
                            <select name="level[{{ skill.id }}]" required>
                                <option value="">Choisir...</option>
                                <option value="IMITER" {% if savedEval and savedEval.level == 'IMITER' %}selected{% endif %}>Imiter</option>
                                <option value="S_ADAPTER" {% if savedEval and savedEval.level == 'S_ADAPTER' %}selected{% endif %}>S'adapter</option>
                                <option value="TRANSPOSER" {% if savedEval and savedEval.level == 'TRANSPOSER' %}selected{% endif %}>Transposer</option>
                            </select>
                        </td>
                        <td>
                            <textarea name="comment[{{ skill.id }}]" rows="2">{{ savedEval ? savedEval.comment : '' }}</textarea>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <button type="submit">Enregistrer l'évaluation</button>
    </form>
{% endblock %}

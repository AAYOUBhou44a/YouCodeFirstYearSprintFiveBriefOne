{% extends "layout/base.html.twig" %}

{% block title %}Ma Progression{% endblock %}

{% block content %}
    <h2>Ma Progression</h2>
    {% for item in progression %}
        <div class="card" style="border:1px solid #ddd; padding:15px; margin-bottom:15px;">
            <h3>Brief: {{ item.brief.title }}</h3>
            <table>
                <thead>
                    <tr>
                        <th>Compétence (ID)</th>
                        <th>Niveau Obtenu</th>
                        <th>Commentaire</th>
                    </tr>
                </thead>
                <tbody>
                    {% for eval in item.evaluations %}
                        <tr>
                            <td>{{ eval.skillId }}</td>
                            <td>
                                <span class="badge {{ eval.level|lower }}">{{ eval.level }}</span>
                            </td>
                            <td>{{ eval.comment }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p>Aucune évaluation disponible.</p>
    {% endfor %}
{% endblock %}
